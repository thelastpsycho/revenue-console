# Copy to .env (repo root, gitignored) - docker compose auto-loads this for
# ${VAR} substitution in docker-compose.yml. This is separate from
# backend/.env, which still holds the app's own secrets (PIN, session
# secret, PMS/D-EDGE creds) and is passed to containers via env_file.

# Scheduler container's arguments. Defaults to safe/preview mode
# (--schedule-60, no --live) if unset - add --live only after verifying one
# successful dry run on this deployment.
SCHEDULER_ARGS=--schedule-60
