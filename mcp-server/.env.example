# Copy to mcp-server/.env (gitignored). Used by the `mcp` service in docker-compose.yml.
#
# No personal API key goes here - this --http deployment has no identity of its own.
# Every remote caller sends their own personal key (minted from the console's MCP Access
# page) as their own Authorization header; see mcp-server/README.md Option A.

# Secret for the remote endpoint, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=

# Required for --http. Public hostname(s) the Cloudflare tunnel routes to this
# service, comma-separated. The server refuses to start without this.
MCP_ALLOWED_HOSTS=

# Optional: the Revenue Console backend's own public URL (e.g.
# https://revcon.yourdomain.com). When set, this server advertises OAuth
# discovery pointing at the backend's Authorization Server, so claude.ai's
# connector setup can offer a real "Sign in" instead of pasting a personal key
# into a header. Leave unset to keep the manual-header-only flow.
REVENUE_CONSOLE_PUBLIC_URL=
