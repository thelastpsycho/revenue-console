# Copy to mcp-server/.env (gitignored). Used by the `mcp` service in docker-compose.yml.

# Same value as APP_ACCESS_PIN in backend/.env.
REVENUE_CONSOLE_PIN=

# Secret for the remote endpoint, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=

# Public hostname(s) the Cloudflare tunnel routes to this service, comma-separated.
MCP_ALLOWED_HOSTS=
