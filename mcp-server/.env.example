# Copy to mcp-server/.env (gitignored). Used by the `mcp` service in docker-compose.yml.

# A Revenue Console account for this server to log in as (create it from the Users
# page, or backend/scripts/bootstrap_admin.py for the very first account). It needs no
# permissions - every tool here only reads, and reads are open to any logged-in account.
REVENUE_CONSOLE_USERNAME=
REVENUE_CONSOLE_PASSWORD=

# Secret for the remote endpoint, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=

# Required for --http. Public hostname(s) the Cloudflare tunnel routes to this
# service, comma-separated. The server refuses to start without this.
MCP_ALLOWED_HOSTS=
