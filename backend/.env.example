# Copy to backend/.env, and generate a random session secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-chars
# Bind Flask to loopback; use a same-origin proxy for remote users.
APP_HOST=127.0.0.1
APP_DEBUG=0
# Set to 1 when serving over HTTPS; requires secure browser cookies.
APP_SECURE_COOKIES=0
# Explicit one-machine development ONLY: APP_HOST must be loopback; no login.
# ALLOW_INSECURE_LOCAL_DEV=1

# Operator accounts live in users.db, not here. Once APP_SESSION_SECRET is
# set, create the first account with every permission by running:
#   python backend/scripts/bootstrap_admin.py
# Every account after that is created from the Users page.

# Credentials for the scheduler container (scripts/trigger_fast_pipeline.py
# --managed) to log in as - create this account from the Users page (or the
# bootstrap script for the very first account) with the "run_pipeline"
# permission.
APP_SCHEDULER_USERNAME=
APP_SCHEDULER_PASSWORD=

# Optional provider credentials (never use VITE_* for these values).
PMS_USERNAME=
PMS_PASSWORD=
DEDGE_USERNAME=
DEDGE_PASSWORD=
# Seconds a run waits for the D-EDGE "new device" code to be entered in
# the console before failing (default 900 = 15 min).
# DEDGE_DEVICE_CODE_TIMEOUT=900

# Optional: n8n webhook URL to notify (e.g. wired to Telegram) after every
# Fast API Pipeline run finishes. Leave unset to disable notifications.
N8N_FAST_PIPELINE_WEBHOOK_URL=

# Stop sale emails (Stop Sale page). One email is sent per recipient.
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USERNAME. The display name is set in the UI.
SMTP_FROM_EMAIL=
