# Copy to backend/.env, pick your own 6-digit PIN, and generate a random
# session secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ACCESS_PIN=replace-with-your-own-6-digit-pin
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-chars
# Bind Flask to loopback; use a same-origin proxy for remote users.
APP_HOST=127.0.0.1
APP_DEBUG=0
# Set to 1 when serving over HTTPS; requires secure browser cookies.
APP_SECURE_COOKIES=0
# Explicit one-machine development ONLY: APP_HOST must be loopback; no login.
# ALLOW_INSECURE_LOCAL_DEV=1

# Optional provider credentials (never use VITE_* for these values).
PMS_USERNAME=
PMS_PASSWORD=
DEDGE_USERNAME=
DEDGE_PASSWORD=
# Seconds a run waits for the D-EDGE "new device" code to be entered in
# the console before failing (default 900 = 15 min).
# DEDGE_DEVICE_CODE_TIMEOUT=900

# Optional: n8n webhook URL to notify (e.g. wired to Telegram) after every
# Fast API Pipeline run finishes. Leave unset to disable notifications.
N8N_FAST_PIPELINE_WEBHOOK_URL=
