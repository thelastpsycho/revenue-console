venv/
ENV/
env/
.env
*.log

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
build/
dist/
coverage/

# D-EDGE / Availpro persistent Chrome profile (holds live session + device-trust cookies)
backend/app/scraper/.dedge_profile/

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Misc
.DS_Store
*.pem
.cache/

# Vite temp config build artifacts
*.timestamp-*.mjs

# Graphify generated knowledge-graph output/cache
graphify-out/

# scripts/trigger_fast_pipeline.sh --schedule lockfile (runtime state, not source)
scripts/.trigger_fast_pipeline.schedule.pid

# Runtime data: generated databases, screenshots, debug HTML/xlsx exports.
# scheduled_fast_pipeline_config.json is a deliberate exception - it's a
# source-controlled default config, not pipeline output.
backend/app/scraper/data/*
!backend/app/scraper/data/.gitkeep
!backend/app/scraper/data/scheduled_fast_pipeline_config.json

